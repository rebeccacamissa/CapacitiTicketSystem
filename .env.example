PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# ---- Database ----------------------------------------------------------------
# Persistent Postgres, e.g. Neon (`neon init` writes this for you). Strongly recommended
# in production: without it the app uses an embedded Postgres (PGlite) stored in
# PGLITE_DIR, which is wiped on hosts with temporary disks such as Render's free plan.
DATABASE_URL=
PGLITE_DIR=./data/pglite

# ---- Demo / production mode ----------------------------------------------------
# true  = one-click demo sign-in and the "Preview as" role switcher (development/assessment)
# false = individual accounts only (production)
DEMO_MODE=true

# ---- Email (Resend) -------------------------------------------------------------
# Without RESEND_API_KEY, emails (password resets, notifications) are written to the server log.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (onboarding@resend.dev works for testing only).
EMAIL_FROM=CAPACITI Support <onboarding@resend.dev>
# Public site address used in email links (Render sets RENDER_EXTERNAL_URL automatically).
APP_URL=http://localhost:3000

# ---- AI (optional) ----------------------------------------------------------------
# Enables AI CV tailoring and the AI mock interviewer (Anthropic Claude).
ANTHROPIC_API_KEY=
